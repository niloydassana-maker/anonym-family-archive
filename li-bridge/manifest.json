{
  "manifest_version": 3,
  "name": "Kilo Bridge (local only)",
  "version": "1.0",
  "description": "Reads LinkedIn DOM into local relay. No remote servers. Acts only on local directives.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*", "http://127.0.0.1:8778/*", "https://mail.google.com/*", "https://mail.yahoo.com/*", "https://www.foundit.in/*", "https://www.naukri.com/*", "https://*.indeed.com/*", "https://kdp.amazon.com/*", "https://web.whatsapp.com/*", "https://www.instagram.com/*", "https://www.facebook.com/*", "https://*.incometax.gov.in/*", "https://drive.google.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*", "https://mail.google.com/*", "https://mail.yahoo.com/*", "https://www.foundit.in/*", "https://www.naukri.com/*", "https://*.indeed.com/*", "https://kdp.amazon.com/*", "https://web.whatsapp.com/*", "https://www.instagram.com/*", "https://www.facebook.com/*", "https://*.incometax.gov.in/*", "https://drive.google.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
